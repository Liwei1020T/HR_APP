# HR App Docker Environment Configuration
# Copy this file to .env and modify as needed

# ========================
# Database Settings
# ========================
POSTGRES_USER=hrapp
POSTGRES_PASSWORD=hrapp123
POSTGRES_DB=hr_app_db
DB_PORT=5432

# ========================
# JWT Authentication
# ========================
# IMPORTANT: Change this in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ========================
# Ports
# ========================
# Change these if ports are already in use on your system
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ========================
# Frontend API URL
# ========================
# This is baked into the frontend at build time
# For local development:
VITE_API_BASE_URL=http://localhost:8000/api/v1
# For production with domain:
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# ========================
# Extra CORS Origins (optional)
# ========================
# Add additional allowed origins, comma-separated
EXTRA_CORS_ORIGINS=

# ========================
# Email Settings (optional)
# ========================
# Options: console, smtp, resend
EMAIL_PROVIDER=console

# SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hrapp.com

# Resend Settings (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# ========================
# AI Settings (optional)
# ========================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
